# Copy this file to .env.local and fill in the values from your Supabase project
# Settings -> API in the Supabase dashboard.
# Both of these are safe to expose to the browser (protected by Row Level Security)
# and must also be set as Environment Variables in the Vercel project settings.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
